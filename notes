UPDATE cart_items ci
JOIN carts c ON ci.cart_id = c.cart_id
JOIN (
    SELECT cart_id, COUNT(*) AS item_count
    FROM cart_items
    GROUP BY cart_id
) x ON ci.cart_id = x.cart_id
SET 
    ci.discount = ci.discount + (c.discount_per_order / x.item_count),
    ci.total = ci.total - (ci.discount + (c.discount_per_order / x.item_count)),
    ci.profit = (ci.total - (ci.discount + (c.discount_per_order / x.item_count))) - ci.cost
WHERE c.discount_per_order != 0;
